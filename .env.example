# Supabase project: public URL + publishable key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Use the Supabase transaction pooler URI (port 6543); URL-encode the password.
DATABASE_URL=
# Only this confirmed email can initialise the workspace Owner.
OWNER_EMAIL=
SUPABASE_STORAGE_BUCKET=tj-sons-files
SEED_DUMMY_DATA=true
APP_BASE_URL=https://your-project.vercel.app
# Optional approved WhatsApp template integration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
